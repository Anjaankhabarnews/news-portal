# Copy to .env.local (development) or set on the server (production).
# Never commit real values.

# Public site origin — used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.anjaankhabar.com

# ---------------------------------------------------------------------------
# Supabase. When these are empty the site runs on built-in demo content.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…; a legacy anon key also works). Safe in the
# browser ONLY because every table has Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret API key (sb_secret_…), from Dashboard → Project Settings → API Keys.
# Server-only: news-tip submissions and signed media uploads. Replaces the legacy
# service_role key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Server-only. Long random string; lets the newsroom dashboard / a Supabase webhook
# refresh the site instantly after publishing (POST /api/revalidate). Content refreshes
# within ~60s without it.
REVALIDATE_SECRET=

# Optional: "demo" forces built-in demo stories (design previews); "supabase" forces the database.
# Default: Supabase when configured, demo otherwise.
CONTENT_SOURCE=

# ---------------------------------------------------------------------------
# Google AdSense (optional). Leave empty to show house / direct ads only.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ADSENSE_CLIENT=
# One slot id per placement (see src/components/ads/ad-config.ts)
NEXT_PUBLIC_ADSENSE_SLOT_LEADERBOARD=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
